{
  "expo": {
    "name": "Persona IA",
    "slug": "persona-ia",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "personaia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#07060F",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.personaia.app",
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "permissions": ["RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS", "INTERNET"],
      "adaptiveIcon": { "backgroundColor": "#07060F" }
    },
    "ios": {
      "bundleIdentifier": "com.personaia.app",
      "supportsTablet": true
    },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-audio"],
    "extra": {
      "eas": { "projectId": "96caacef-0bd9-4568-89ef-a6d33e56672f" }
    },
    "owner": "winterark90"
  }
}
